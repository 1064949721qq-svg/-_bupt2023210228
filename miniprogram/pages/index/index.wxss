.container {
  padding: 20rpx;
  padding-bottom: 140rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.device-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #999;
}

.online .status-dot {
  background-color: #52c41a;
  box-shadow: 0 0 12rpx rgba(82, 196, 26, 0.5);
}

.offline .status-dot {
  background-color: #ff4d4f;
}

.status-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.update-time {
  font-size: 24rpx;
  color: #999;
}

.data-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.data-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-text {
  font-size: 40rpx;
  font-weight: bold;
}

.card-label {
  font-size: 26rpx;
  color: #999;
}

.card-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.2;
}

.card-trend {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.card-trend.up {
  color: #52c41a;
}

.card-trend.down {
  color: #ff4d4f;
}

.card-trend.stable {
  color: #999;
}

.control-panel {
  margin-bottom: 30rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.control-items {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.control-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.control-name {
  font-size: 30rpx;
  color: #555;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 40rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.btn-refresh {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
}

.btn-settings {
  width: 160rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f7fa;
  color: #666;
  font-size: 28rpx;
  border-radius: 44rpx;
  border: none;
}