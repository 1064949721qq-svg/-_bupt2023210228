.container {
  padding: 20rpx;
}

.filter-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.filter-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.filter-label {
  font-size: 24rpx;
  color: #999;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
  padding: 16rpx 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-weight: 500;
}

.chart-area {
  margin-bottom: 20rpx;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
  gap: 10rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.chart-stats {
  font-size: 24rpx;
  color: #999;
}

.chart-container {
  display: flex;
  gap: 16rpx;
}

.chart-y-axis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  width: 80rpx;
  padding: 20rpx 0;
}

.y-label {
  font-size: 22rpx;
  color: #999;
}

.chart-content {
  flex: 1;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 300rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #e8e8e8;
}

.bar-item {
  flex: 1;
  min-height: 10rpx;
  border-radius: 6rpx 6rpx 0 0;
  position: relative;
  transition: all 0.3s ease;
  background: linear-gradient(180deg, #1890ff, #096dd9);
}

.bar-item:active {
  opacity: 0.8;
}

.bar-tooltip {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.chart-x-axis {
  display: flex;
  justify-content: space-around;
  padding-top: 12rpx;
}

.x-label {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-state {
  text-align: center;
  padding: 60rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  display: block;
  margin-bottom: 30rpx;
}

.btn-load-mock {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 44rpx;
  border: none;
}

.data-list {
  margin-bottom: 20rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.list-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.list-count {
  font-size: 24rpx;
  color: #999;
}

.list-scroll {
  border-radius: 12rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.list-item:last-child {
  border-bottom: none;
}

.item-time {
  font-size: 26rpx;
  color: #666;
}

.item-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #1890ff;
}